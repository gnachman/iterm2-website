RewriteEngine On

RewriteCond %{REQUEST_URI}  ^/appcasts/testing.xml
RewriteCond %{QUERY_STRING} ^shard=([0-9]*)$
RewriteRule ^.*$ /appcasts/shard-%1/testing.xml [R=302,L]

RewriteCond %{REQUEST_URI}  ^/appcasts/testing_changes.txt
RewriteCond %{QUERY_STRING} ^shard=([0-9]*)$
RewriteRule ^.*$ /appcasts/shard-%1/testing_changes.txt [R=302,L]

RewriteCond %{REQUEST_URI}  ^/appcasts/testing_new.xml
RewriteCond %{QUERY_STRING} ^shard=([0-9]*)$
RewriteRule ^.*$ /appcasts/shard-%1/testing_new.xml [R=302,L]

AddCharset UTF-8 .txt


# iTerm2 builds with the NoSyncSoftwareUpdateTestFeed user default set append
# test=TOKEN to the appcast URL. Serve the staged copy of the same appcast from
# /misc, where test.sh puts appcasts awaiting testing, instead of the public
# one. The rewrite is internal, so the public appcast's URL and caching are
# unaffected.
RewriteCond %{QUERY_STRING} (^|&)test=[A-Za-z0-9_-]{1,64}(&|$)
RewriteRule ^([a-z0-9_]+\.xml)$ /misc/$1 [L]
